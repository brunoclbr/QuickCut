  "open_source_policy": "This repo ships only code and metadata. Every third-party file is fetched or downloaded by each user onto their own machine and stays out of git. Sources whose terms require permission for use with an editing application are excluded (DrawKit: its licence forbids use in template creators or applications).",
  "motion": [
    {
      "id": "editorial-proof",
      "name": "Floating proof",
      "functions": [
        "proofIn",
        "proofOut"
      ],
      "tags": [
        "proof",
        "screenshot",
        "result",
        "document",
        "evidence",
        "float",
        "card",
        "overlay"
      ],
      "when": "The speaker says \"here is the result\" or cites a real document.",
      "description": "A real screenshot floats in over the footage, stays readable, then exits on a sentence boundary.",
      "timing": "in 0.40–0.52 s; readable ≥ 1.3 s; out 0.20–0.32 s",
      "hold": 2.1,
      "html": "  <div id=\"{id}\" style=\"position:absolute; left:72px; right:72px; top:520px; border-radius:20px; overflow:hidden; box-shadow:0 22px 60px rgba(0,0,0,.45);\"><img src=\"assets/your-real-screenshot.png\" alt=\"\" style=\"display:block; width:100%;\"></div>",
      "timeline": "HFEditorial.proofIn(tl, \"{target}\", {at}); HFEditorial.proofOut(tl, \"{target}\", {exit});"
    },
    {
      "id": "editorial-pip",
      "name": "Picture-in-picture",
      "functions": [
        "pipIn"
      ],
      "tags": [
        "pip",
        "picture-in-picture",
        "inset",
        "camera",
        "screen",
        "recording",
        "demo",
        "floating"
      ],
      "when": "The speaker explains a real on-screen action.",
      "description": "Screen recording full frame with the camera footage as a small inset.",
      "timing": "in 0.40–0.55 s; hard cut out",
      "hold": 3,
      "html": "  <div id=\"{id}\" style=\"position:absolute; right:72px; bottom:560px; width:300px; height:400px; border-radius:20px; overflow:hidden;\"><video src=\"assets/your-camera.mp4\" muted playsinline style=\"width:100%; height:100%; object-fit:cover;\"></video></div>",
      "timeline": "HFEditorial.pipIn(tl, \"{target}\", {at});"
    },
    {
      "id": "editorial-focus",
      "name": "Focus / click",
      "functions": [
        "focusIn",
        "focusOut"
      ],
      "tags": [
        "focus",
        "click",
        "button",
        "ui",
        "control",
        "dim",
        "outline",
        "callout",
        "highlight"
      ],
      "when": "A specific UI control is named or clicked.",
      "description": "Dims the rest of a real screen capture 30–45% and outlines the control (no glow).",
      "timing": "in 0.18–0.26 s; release with focusOut",
      "hold": 1.2,
      "html": "  <div id=\"{id}-dim\" style=\"position:absolute; inset:0; background:#000;\"></div>\n  <div id=\"{id}-outline\" style=\"position:absolute; left:120px; top:900px; width:840px; height:140px; border:5px solid #b6ccee; border-radius:22px;\"></div>",
      "timeline": "HFEditorial.focusIn(tl, \"{target}-dim\", \"{target}-outline\", {at}); HFEditorial.focusOut(tl, \"{target}-dim\", \"{target}-outline\", {exit});"
    },
    {
      "id": "editorial-match-expand",
      "name": "Match expand",
      "functions": [
        "matchExpand"
      ],
      "tags": [
        "expand",
        "match",
        "cut",
        "zoom",
        "thumbnail",
        "fullscreen",
        "cutaway",
        "transition"
      ],
      "when": "A thumbnail becomes the same screenshot full screen.",
      "description": "Expands a real thumbnail into the same image full frame. Never between unrelated images.",
      "timing": "0.48–0.65 s",
      "hold": 0.6,
      "html": "  <img id=\"{id}-thumb\" src=\"assets/your-real-screenshot.png\" alt=\"\" style=\"position:absolute; left:340px; top:700px; width:400px; border-radius:22px;\">\n  <img id=\"{id}\" src=\"assets/your-real-screenshot.png\" alt=\"\" style=\"position:absolute; inset:0; width:100%; height:100%; object-fit:cover;\">",
      "timeline": "HFEditorial.matchExpand(tl, \"{target}-thumb\", \"{target}\", {at});"
    },
    {
      "id": "editorial-steps",
      "name": "Step reveal",
      "functions": [
        "stepsIn"
      ],
      "tags": [
        "steps",
        "list",
        "sequence",
        "instructions",
        "numbered",
        "process",
        "reveal",
        "indicator"
      ],
      "when": "Explaining ordered instructions, 2–4 steps.",
      "description": "Reveals real steps one by one in the approved words, without covering the footage.",
      "timing": "0.35–0.55 s stagger",
      "hold": 3,
      "html": "  <div id=\"{id}\" style=\"position:absolute; left:72px; top:600px;\"><div class=\"step\">01  First step</div><div class=\"step\">02  Second step</div><div class=\"step\">03  Third step</div></div>",
      "timeline": "HFEditorial.stepsIn(tl, document.querySelectorAll(\"{target} .step\"), {at});"
    },
    {
      "id": "editorial-comparison",
      "name": "Before / after comparison",
      "functions": [
        "comparisonReveal"
      ],
      "tags": [
        "before",
        "after",
        "compare",
        "comparison",
        "versus",
        "split",
        "options"
      ],
      "when": "A genuine side-by-side of two real images or screenshots.",
      "description": "Reveals the \"after\" panel beside the \"before\" with a divider. Labels explicit; never imply an altered result.",
