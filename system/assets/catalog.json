      "commercial_videos": true,
      "redistributable": false,
      "tools_templates": false,
      "ai_training": false,
      "attribution": "none",
      "acquisition": "npm",
      "package": "gsap",
      "version": "3.14.2",
      "files": {
        "dist/gsap.min.js": "gsap.min.js"
      },
      "install_to": "system/assets/vendor"
    },
    "lottie-web": {
      "name": "lottie-web 5.13.0 (Lottie player HyperFrames seeks via window.__hfLottie)",
