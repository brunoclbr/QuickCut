{
  "version": 1,
  "root": "workspace/assets",
  "paths": "Asset paths are relative to root; install_to is relative to the repo root.",
  "license_fields": "commercial_videos: may appear in published finished videos; redistributable: raw files may be shared/committed/packaged; tools_templates: may ship inside an editing tool or template; ai_training: may be used to train models (never do this regardless).",
  "sources": {
    "original": {
      "name": "Original assets made for this repo",
      "license": "Owned by the repo owner",
      "commercial_videos": true,
      "redistributable": true,
      "tools_templates": true,
      "ai_training": false,
      "attribution": "none",
      "acquisition": "repo",
      "from": "system/assets/originals",
      "install_to": "workspace/assets/animations/lottie/original"
    },
    "gsap": {
      "name": "GSAP 3.14.2 (animation runtime used by all compositions)",
