      "license_url": "https://github.com/airbnb/lottie-web/blob/master/LICENSE.md",
      "commercial_videos": true,
      "redistributable": true,
      "tools_templates": true,
      "ai_training": false,
      "attribution": "keep MIT notice",
      "acquisition": "npm",
      "package": "lottie-web",
      "version": "5.13.0",
      "files": {
        "build/player/lottie.min.js": "lottie.min.js",
        "LICENSE.md": "lottie-web-LICENSE.md"
      },
      "install_to": "system/assets/vendor"
    },
