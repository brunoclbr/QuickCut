      "commercial_videos": true,
      "redistributable": true,
      "tools_templates": false,
      "ai_training": false,
      "attribution": "optional, encouraged",
      "note": "The license allows redistribution, but compiling LottieFiles files into a similar service is forbidden and their site terms ban bots. Treat as local-only; record creator and URL per file.",
      "acquisition": "manual",
      "install_to": "workspace/assets/animations/lottie/lottiefiles",
      "manual_steps": "Download the Lottie JSON from the animation page while signed in, then ask your AI app to import it with its page URL and creator."
