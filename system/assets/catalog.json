      "license": "MIT",
      "license_url": "https://github.com/phosphor-icons/core/blob/main/LICENSE",
      "commercial_videos": true,
      "redistributable": true,
      "tools_templates": true,
      "ai_training": false,
      "attribution": "keep MIT notice",
      "acquisition": "npm",
      "package": "@phosphor-icons/core",
      "version": "2.1.1",
      "dirs": {
        "assets/regular": "regular",
        "assets/bold": "bold",
        "assets/fill": "fill",
        "assets/duotone": "duotone"
      },
      "files": {
        "LICENSE": "LICENSE"
      },
      "install_to": "workspace/assets/icons/phosphor",
      "note": "Thin/light weights skipped: hairlines do not read on a phone screen. Any of ~1,500 icons can be used by name: phosphor/<weight>/<name>.svg."
    },
    "pixabay": {
      "name": "Pixabay sound effects bundled with the HyperFrames media-use skill",
      "url": "https://pixabay.com/sound-effects/",
      "license": "Pixabay Content License",
      "license_url": "https://pixabay.com/service/license-summary/",
      "commercial_videos": true,
      "redistributable": false,
      "tools_templates": false,
      "ai_training": false,
      "attribution": "none required",
      "note": "Pixabay forbids distributing files on a standalone basis, so they stay local even though HyperFrames bundles them.",
      "acquisition": "local-skill",
      "candidates": [
        "~/.claude/skills/media-use/audio/assets/sfx",
        "~/.agents/skills/media-use/audio/assets/sfx"
      ],
      "install_to": "workspace/assets/sounds/pixabay"
    },
    "mixkit": {
      "name": "Mixkit free sound effects (curated list)",
      "url": "https://mixkit.co/free-sound-effects/",
      "license": "Mixkit Sound Effects Free License",
      "license_url": "https://mixkit.co/license/#sfxFree",
      "commercial_videos": true,
      "redistributable": false,
      "tools_templates": false,
      "ai_training": false,
      "attribution": "none required",
      "note": "Terms forbid scripts/bots for downloading, so each file is downloaded by hand from the website.",
      "acquisition": "manual",
      "match": "^mixkit-.+\\.(wav|mp3)$",
      "install_to": "workspace/assets/sounds/mixkit",
      "manual_steps": "Open each category page, find the titles listed by `status`, click Download, then run setup again."
    },
    "open-stickers": {
      "name": "Craftwork Open Stickers (80 illustrations)",
      "url": "https://openstickers.craftwork.design/",
      "license": "Craftwork License (free products)",
      "license_url": "https://craftwork.design/license/",
      "commercial_videos": true,
      "redistributable": false,
      "tools_templates": false,
      "ai_training": false,
      "attribution": "appreciated, not required",
      "note": "No redistribution or sharing of the files; not for templates or products.",
      "acquisition": "manual",
      "match": "(open.?stickers|craftwork).*\\.zip$",
      "keep": [
        "svg"
      ],
      "install_to": "workspace/assets/illustrations/open-stickers",
      "manual_steps": "Get the free pack from https://craftwork.gumroad.com/l/gxaylb (enter 0), save the zip to Downloads, run setup again."
    },
